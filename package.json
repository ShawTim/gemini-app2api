{
  "name": "gemini-app2api",
  "version": "1.0.0",
  "description": "Independent Gemini HTTP2 gateway with an explicit prompt-tool protocol, scoped OpenAI compatibility, secure multi-account routing and operations console.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawTim/gemini-app2api.git"
  },
  "type": "module",
  "main": "src/gateway/app.mjs",
  "files": [
    "bin/gemini-gateway",
    ".env.example",
    "scripts/internal-server.mjs",
    "scripts/internal-service.mjs",
    "test/current-contract-runner-offline.mjs",
    "scripts/run-current-contract.mjs",
    "scripts/offline-contract-network-guard.mjs",
    "scripts/offline-client-fixture.mjs",
    "scripts/verify-prompt-byte-limit.mjs",
    "test/models-metadata-offline.mjs",
    "test/responses-delivery-offline.mjs",
    "test/responses-namespaces-offline.mjs",
    "test/zero-output-terminal-offline.mjs",
    "test/nonmonotonic-commit-boundary-offline.mjs",
    "src/gateway-server.mjs",
    "src/gateway/",
    "src/admin-v2/index.html",
    "src/admin-v2/app.js",
    "src/admin-v2/styles.css",
    "src/native-provider.mjs",
    "src/tool-protocol.mjs",
    "src/prompt-tool-schema.mjs",
    "src/openai-contract.mjs",
    "src/openai-usage.mjs",
    "src/responses-tool-namespaces.mjs",
    "src/image-input.mjs",
    "src/image-url.mjs",
    "native-wire/consumer-tool-codec.mjs",
    "native-wire/protobuf.mjs",
    "native-wire/robin-current.mjs",
    "native-wire/oauth-loopback.mjs",
    "docs/API_SUPPORT.md",
    "docs/COMPLETION_CONTRACT.md",
    "docs/ACCOUNT_LIFECYCLE.md",
    "docs/OPERATIONS.md",
    "docs/LOCKS_AND_LIMITS.md",
    "docs/TEST_EXECUTION_SAFETY.md",
    "docs/DEPENDENCIES.md",
    "docs/CURRENT_CONTRACT_TESTS.md",
    "docs/assets/",
    "examples/",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "README.zh.md",
    "DISCLAIMER.md"
  ],
  "bin": {
    "gemini-gateway": "bin/gemini-gateway"
  },
  "scripts": {
    "start": "node src/gateway-server.mjs",
    "dev": "node --watch src/gateway-server.mjs",
    "internal:start": "node scripts/internal-server.mjs start",
    "internal:stop": "node scripts/internal-server.mjs stop",
    "internal:restart": "node scripts/internal-server.mjs restart",
    "internal:status": "node scripts/internal-server.mjs status",
    "internal:rollback": "node scripts/internal-server.mjs rollback",
    "internal:supervise": "node scripts/internal-server.mjs supervise",
    "internal:service:install": "node scripts/internal-service.mjs install",
    "internal:service:uninstall": "node scripts/internal-service.mjs uninstall",
    "internal:service:status": "node scripts/internal-service.mjs status",
    "test": "node scripts/run-offline-product.mjs --run",
    "test:current-contract": "node scripts/run-current-contract.mjs --run",
    "test:historical": "node scripts/run-historical-tests.mjs --run",
    "test:admin": "node --test test/admin-v2-static.test.mjs",
    "test:product": "node scripts/run-offline-product.mjs --run",
    "test:browser": "playwright test --config test/browser/playwright.config.mjs",
    "test:release": "node scripts/check-release.mjs",
    "test:python": "node scripts/sdk-smoke.mjs",
    "test:docker": "node scripts/docker-smoke.mjs",
    "release:source": "node scripts/export-release.mjs",
    "preview:admin": "node test/browser/server.mjs",
    "status": "node bin/gemini-gateway status"
  },
  "keywords": [
    "gemini",
    "argon",
    "openai-api",
    "gateway",
    "cursor",
    "roo-code",
    "cline",
    "multi-account",
    "sticky-session",
    "failover"
  ],
  "author": "shawtim",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "openai": "7.42.0",
    "prettier": "3.9.10"
  }
}
