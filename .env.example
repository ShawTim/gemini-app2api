# Copy to .env, chmod 600 .env, and keep .env out of version control.
# Empty/unset: skip the admin password screen on a loopback-only gateway.
# Set a unique 12-256 character value to require admin login.
# A non-loopback bind or remote public origin REQUIRES a configured password.
GATEWAY_ADMIN_PASSWORD=

# Compose only: published host port; container listener and health check stay on 18989.
# Compose derives http://127.0.0.1:<published port> unless an exact origin is supplied.
# GATEWAY_PUBLISHED_PORT=28989
# GATEWAY_PUBLIC_ORIGIN=https://gateway.example.test
# Direct docker run requires an explicit GATEWAY_PUBLIC_ORIGIN matching the client URL.
# OAuth callback remains localhost:18765; changing the gateway port does not remap it.

# Optional generation routing allowlist. Exact IDs from admin; keep real IDs private.
# Absent: all otherwise eligible accounts. []: deny all. Invalid/blank/null: startup fails.
# GATEWAY_ROUTING_ACCOUNT_IDS=["example-account-id"]

# Optional: only explicit quota exhaustion/insufficient-budget errors may switch accounts.
# Try every eligible account once under the original deadline; never substitute a model.
# GATEWAY_QUOTA_FAILOVER=1
# Optional: recover once from a fully verified empty ordinary response on another account.
# Explicit quota refusals do not consume the non-quota recovery budget; never repairs outputs.
# GATEWAY_EMPTY_RESPONSE_FAILOVER=1
# Integrated mode: recover temporary transport/empty/tool-format failures inside one request.
# Regenerate complete tool errors under unchanged validation: 4 non-quota attempts, plus quota refusals.
# GATEWAY_AUTOMATIC_RECOVERY=1
