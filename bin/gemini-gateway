#!/usr/bin/env node
/** Release CLI. Foreground lifecycle; never launches or hooks a desktop App. */
import { StateStore, fault } from "../src/gateway/state.mjs";
import { loadLocalEnvironment } from "../src/gateway/environment.mjs";
import { jsonRpcError } from "../src/gateway/mcp-core.mjs";
const [command = "help", ...args] = process.argv.slice(2);
async function input() {
  let bytes = 0,
    text = "";
  for await (const b of process.stdin) {
    bytes += b.length;
    if (bytes > 1024 * 1024) throw fault("INPUT_TOO_LARGE");
    text += b;
  }
  try {
    return JSON.parse(text);
  } catch {
    throw fault("INVALID_JSON");
  }
}
try {
  // Never auto-load untrusted project cwd `.env` when running as an MCP stdio bridge.
  if (command !== "mcp") loadLocalEnvironment();
  if (command === "start") {
    if (args.length) throw fault("UNSUPPORTED_ARGUMENT");
    await import("../src/gateway-server.mjs");
  } else if (command === "init") {
    if (args.length) throw fault("UNSUPPORTED_ARGUMENT");
    const store = new StateStore();
    console.log(
      JSON.stringify({ initialized: true, directory: store.directory }),
    );
  } else if (command === "import-profile") {
    const store = new StateStore();
    store.lock();
    try {
      store.importProfile(await input());
      console.log(JSON.stringify({ profileImported: true }));
    } finally {
      store.unlock();
    }
  } else if (command === "create-key") {
    const store = new StateStore();
    store.lock();
    try {
      console.log(JSON.stringify(store.createKey(args.join(" ") || "CLI key")));
    } finally {
      store.unlock();
    }
  } else if (command === "reset-admin") {
    throw fault("ADMIN_PASSWORD_MANAGED_BY_ENV", 409);
  } else if (command === "status") {
    const origin =
      process.env.GATEWAY_PUBLIC_ORIGIN ||
      `http://127.0.0.1:${process.env.PORT || 18989}`;
    const res = await fetch(new URL("/ready", origin), {
      signal: AbortSignal.timeout(3000),
      redirect: "error",
    });
    console.log(JSON.stringify(await res.json()));
    if (!res.ok) process.exitCode = 1;
  } else if (command === "mcp") {
    if (args.length) throw fault("UNSUPPORTED_ARGUMENT");
    const origin =
      (process.env.GEMINI_GATEWAY_URL || "").trim() ||
      (process.env.GATEWAY_PUBLIC_ORIGIN || "").trim() ||
      `http://127.0.0.1:${process.env.PORT || 18989}`;
    const apiKey = (process.env.GEMINI_GATEWAY_API_KEY || "").trim();
    const mcpUrl = new URL("/mcp", origin);
    const loopbackHosts = new Set(["127.0.0.1", "localhost", "[::1]", "::1"]);
    if (!["http:", "https:"].includes(mcpUrl.protocol) || mcpUrl.username || mcpUrl.password) {
      throw fault("INVALID_GATEWAY_URL");
    }
    if (mcpUrl.protocol === "http:" && !loopbackHosts.has(mcpUrl.hostname.toLowerCase())) {
      throw fault("INVALID_GATEWAY_URL");
    }
    const maxLineBytes = 32 * 1024 * 1024;
    const maxResponseBytes = 8 * 1024 * 1024;
    const requestTimeoutMs = 300_000;
    const writeLine = (obj) => {
      try {
        process.stdout.write(JSON.stringify(obj) + "\n");
      } catch {}
    };
    const readBoundedText = async (res) => {
      if (!res.body) return "";
      const chunks = [];
      let total = 0;
      for await (const chunk of res.body) {
        const buf = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);
        total += buf.length;
        if (total > maxResponseBytes) throw fault("GATEWAY_RESPONSE_TOO_LARGE", 502);
        chunks.push(buf);
      }
      return Buffer.concat(chunks, total).toString("utf8");
    };
    const inFlight = new Set();
    const forward = async (rawLine) => {
      const trimmed = rawLine.trim();
      if (!trimmed) return;
      let parsed;
      try {
        parsed = JSON.parse(trimmed);
      } catch {
        writeLine(jsonRpcError(null, -32700, "Parse error"));
        return;
      }
      const hasId = parsed && typeof parsed === "object" && !Array.isArray(parsed) && Object.hasOwn(parsed, "id");
      const reqId = hasId ? parsed.id : null;
      const headers = {
        "Content-Type": "application/json",
        Accept: "application/json, text/event-stream",
        "MCP-Protocol-Version": "2025-06-18",
      };
      if (apiKey) headers.Authorization = `Bearer ${apiKey}`;
      try {
        const res = await fetch(mcpUrl, {
          method: "POST",
          headers,
          body: JSON.stringify(parsed),
          redirect: "error",
          signal: AbortSignal.timeout(requestTimeoutMs),
        });
        if (!hasId || res.status === 202) {
          try { await res.body?.cancel?.(); } catch {}
          return;
        }
        const text = await readBoundedText(res);
        let body = null;
        try { body = text.trim() ? JSON.parse(text) : null; } catch { body = null; }
        if (!res.ok) {
          const code = typeof body?.error?.code === "string" ? body.error.code : `HTTP_${res.status}`;
          const msg = typeof body?.error?.message === "string" ? body.error.message : `Gateway /mcp returned HTTP ${res.status}`;
          writeLine(jsonRpcError(reqId, -32000, `${code}: ${msg}`.slice(0, 512)));
          return;
        }
        if (!body || typeof body !== "object" || body.jsonrpc !== "2.0") {
          writeLine(jsonRpcError(reqId, -32603, "Invalid JSON-RPC response from gateway /mcp"));
          return;
        }
        writeLine(body);
      } catch (err) {
        if (hasId) {
          writeLine(jsonRpcError(reqId, -32603, String(err?.message || "Gateway /mcp request failed").slice(0, 512)));
        }
      }
    };
    const track = (line) => {
      const p = forward(line).finally(() => inFlight.delete(p));
      inFlight.add(p);
    };
    let chunks = [];
    let bufferedBytes = 0;
    let droppingOversizedLine = false;
    for await (const chunk of process.stdin) {
      const piece = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);
      let offset = 0;
      while (offset < piece.length) {
        const nl = piece.indexOf(0x0a, offset);
        if (droppingOversizedLine) {
          if (nl === -1) break;
          droppingOversizedLine = false;
          offset = nl + 1;
          continue;
        }
        const sliceEnd = nl === -1 ? piece.length : nl;
        const segment = piece.subarray(offset, sliceEnd);
        if (bufferedBytes + segment.length > maxLineBytes) {
          chunks = [];
          bufferedBytes = 0;
          writeLine(jsonRpcError(null, -32600, "Request line exceeds maximum size"));
          if (nl === -1) {
            droppingOversizedLine = true;
            break;
          }
          offset = nl + 1;
          continue;
        }
        if (nl === -1) {
          chunks.push(segment);
          bufferedBytes += segment.length;
          break;
        }
        const lineBuf = chunks.length ? Buffer.concat([...chunks, segment], bufferedBytes + segment.length) : segment;
        chunks = [];
        bufferedBytes = 0;
        track(lineBuf.toString("utf8"));
        offset = nl + 1;
      }
    }
    if (!droppingOversizedLine && bufferedBytes > 0) {
      track(Buffer.concat(chunks, bufferedBytes).toString("utf8"));
    }
    await Promise.allSettled([...inFlight]);
  } else if (command === "help")
    console.log(`Gemini App2API · Native Direct Gateway

  gemini-gateway init           Initialize private state; admin password comes from .env / environment
  gemini-gateway import-profile Optional: override OAuth client profile JSON on stdin (server stopped)
  gemini-gateway start          Foreground server; Ctrl-C / SIGTERM for graceful shutdown
  gemini-gateway status         Readiness only; never invokes a model
  gemini-gateway mcp            Stdio MCP bridge to the local gateway's POST /mcp endpoint
  gemini-gateway create-key LABEL  Print a new API key ONCE (server stopped)
  Admin password: edit untracked .env GATEWAY_ADMIN_PASSWORD and restart (no state-password reset)

State: GATEWAY_DATA_DIR (default ~/.gemini-app2api), private and independent of legacy config.
Google login: open /admin; enter the configured admin password, or skip it on local passwordless mode. You perform Google/MFA.
No App, dylib, IPC or tool executor. Tools use an explicitly disclosed prompt protocol.`);
  else throw fault("UNKNOWN_COMMAND");
} catch (error) {
  console.error(
    JSON.stringify({
      error: {
        code: /^[A-Z0-9_]+$/.test(error.code ?? "") ? error.code : "CLI_FAILED",
      },
    }),
  );
  process.exitCode = 1;
}
